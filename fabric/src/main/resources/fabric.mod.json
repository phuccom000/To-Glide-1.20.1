{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://github.com/phuccom000/To-Glide-1.20.1",
    "sources": "https://github.com/phuccom000/To-Glide-1.20.1"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.stirdrem.toglide.GlidingFabric"
    ],
    "fabric-datagen": [
      "net.stirdrem.toglide.GlidingDataGenerator"
    ],
    "client": [
      "net.stirdrem.toglide.GlidingClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "yet_another_config_lib_v3": ">=3.6.1+1.20.1-fabric"
  },
  "suggests": {
    "another-mod": "*"
  }
}
  